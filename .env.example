# ---- Google ----
# One OAuth client (credentials.json) can be used to log in as two different
# Google accounts — each produces its own token file.
GOOGLE_CREDENTIALS_FILE=credentials.json
CLASSROOM_TOKEN_FILE=classroom_token.json   # created when you log in as your SCHOOL account
CALENDAR_TOKEN_FILE=calendar_token.json     # created when you log in as your PERSONAL account
CALENDAR_ID=primary

# ---- Behaviour ----
TIMEZONE=Asia/Hebron
REMINDER_MINUTES=60
EVENT_LENGTH_MINUTES=30
DATE_ONLY_DUE_TIME=23:59
LOOKAHEAD_DAYS=120
DELETE_COMPLETED=true

# ---- Jira (leave blank to skip Jira entirely) ----
JIRA_BASE_URL=https://.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_JQL=assignee = currentUser() AND duedate IS NOT EMPTY AND statusCategory != Done
